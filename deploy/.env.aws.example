# Copia este archivo a .env (en la carpeta deploy/) y completa los valores.
# NO subas el .env real al repositorio.

# --- Identidad (Microsoft Entra ID) ---
AZURE_TENANT_ID=<directory-tenant-id>
AZURE_CLIENT_ID=<application-client-id>
AZURE_AUDIENCE=api://<application-client-id>

# --- Frontend (se embeben en el build de Vite) ---
VITE_CLIENT_ID=<application-client-id>
VITE_TENANT_ID=<directory-tenant-id>
VITE_API_SCOPE=api://<application-client-id>/access_as_user

# --- URLs públicas (se conocen al crear la infraestructura) ---
# PUBLIC_HOST = IP pública de la EC2 con guiones + .sslip.io  (ej: 13-58-0-0.sslip.io)
PUBLIC_HOST=<ip-con-guiones>.sslip.io
# El frontend vive en https://PUBLIC_HOST
FRONTEND_ORIGIN=https://<ip-con-guiones>.sslip.io
VITE_REDIRECT_URI=https://<ip-con-guiones>.sslip.io
# URL de invocación del API Gateway (HTTPS) que apunta al BFF
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com
